<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Aki.Common">
      <HintPath>lib/Aki.Common.dll</HintPath>
    </Reference>
    <Reference Include="Aki.Core">
      <HintPath>lib/Aki.Core.dll</HintPath>
    </Reference>
    <Reference Include="Aki.Protocol">
      <HintPath>lib/Aki.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="Aki.Generated">
      <HintPath>lib/Aki.Generated.dll</HintPath>
    </Reference>
    <Reference Include="Aki.TdInterface">
      <HintPath>lib/Aki.TdInterface.dll</HintPath>
    </Reference>
    <ProjectReference Include="../unreal-shim/UnrealEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="domain_routes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
